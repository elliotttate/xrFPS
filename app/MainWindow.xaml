<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="xrFPS.ControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource RootBackgroundBrush}"
        RequestedTheme="Dark"
        SizeChanged="RootGrid_SizeChanged">

        <NavigationView
            x:Name="MainNavigation"
            AlwaysShowHeader="False"
            Background="{ThemeResource RootBackgroundBrush}"
            CompactPaneLength="56"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            OpenPaneLength="248"
            PaneDisplayMode="Auto"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,10,0,18">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource BrandBrush}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#FF071113" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="xrFPS" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock
                            Text="CONTROL CENTER"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="140"
                            Foreground="{ThemeResource BrandBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavDashboard"
                    Content="Dashboard"
                    Tag="0"
                    AutomationProperties.Name="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavGesture"
                    Content="Gesture"
                    Tag="1"
                    AutomationProperties.Name="Gesture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavAppearance"
                    Content="Placement &amp; look"
                    Tag="2"
                    AutomationProperties.Name="Placement and look">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavReadouts"
                    Content="Readouts"
                    Tag="3"
                    AutomationProperties.Name="Readouts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavInstall"
                    Content="Installation"
                    Tag="4"
                    AutomationProperties.Name="Installation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="ActionInfoBar"
                    Grid.Row="0"
                    Margin="28,12,28,0"
                    IsOpen="False"
                    IsClosable="True"
                    AutomationProperties.LiveSetting="Polite" />

                <ScrollViewer
                    Grid.Row="1"
                    Padding="28,20,28,28"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="MainContent"
                        Spacing="20"
                        MaxWidth="1000"
                        HorizontalAlignment="Center">

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PageEyebrow" Text="OVERLAY" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock
                                x:Name="PageSubtitle"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Flip a controller upside down to see your frame rate in any OpenXR game." />
                        </StackPanel>

                        <!-- DASHBOARD -->
                        <StackPanel x:Name="PageDashboard" Spacing="18">
                            <Grid x:Name="DashboardTopGrid" ColumnSpacing="18" RowSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="DashboardStatusCard" Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Ellipse
                                                x:Name="StatusDot"
                                                Width="10"
                                                Height="10"
                                                Fill="{ThemeResource MutedTextBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="StatusHeadline"
                                                Text="Checking installation"
                                                Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="StatusDetail" Style="{StaticResource MutedTextStyle}" FontSize="13" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button
                                                x:Name="InstallButton"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Install layer"
                                                Click="Install_Click" />
                                            <Button
                                                x:Name="UninstallButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Uninstall"
                                                Click="Uninstall_Click" />
                                            <Button
                                                x:Name="ReinstallButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Update files"
                                                Click="Install_Click" />
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource CardStrokeBrush}" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Overlay enabled" Style="{StaticResource SettingLabelStyle}" />
                                                <TextBlock
                                                    Text="Applies instantly, even to a game already running."
                                                    Style="{StaticResource MutedTextStyle}"
                                                    FontSize="12" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="EnabledToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Overlay enabled"
                                                HorizontalAlignment="Right"
                                                OnContent="On"
                                                OffContent="Off"
                                                Toggled="Setting_Changed" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    x:Name="DashboardPreviewCard"
                                    Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                        <ComboBox
                                            x:Name="PreviewRateCombo1"
                                            Header="Headset refresh rate"
                                            AutomationProperties.Name="Preview headset refresh rate"
                                            SelectionChanged="PreviewRate_Changed">
                                            <ComboBoxItem Content="72 Hz" />
                                            <ComboBoxItem Content="80 Hz" />
                                            <ComboBoxItem Content="90 Hz" />
                                            <ComboBoxItem Content="120 Hz" />
                                            <ComboBoxItem Content="144 Hz" />
                                        </ComboBox>
                                        <Border CornerRadius="10" Padding="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF253044" Offset="0" />
                                                    <GradientStop Color="#FF11151C" Offset="0.5" />
                                                    <GradientStop Color="#FF344054" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                        </Border>
                                        <TextBlock
                                            Style="{StaticResource MutedTextStyle}"
                                            FontSize="11"
                                            Text="Rendered by the layer's HUD code. Scene brightness and the runtime compositor can affect the headset result." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Live system metrics" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock
                                            x:Name="CollectorStatus"
                                            Style="{StaticResource MutedTextStyle}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="Metrics stay live while the Control Center is open or minimized."
                                        Style="{StaticResource MutedTextStyle}"
                                        FontSize="12" />
                                    <Grid x:Name="MetricTiles" ColumnSpacing="14" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="MetricCpu" Grid.Column="0">
                                            <TextBlock Text="CPU" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock x:Name="TileCpu" Text="--" FontSize="24" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel x:Name="MetricGpu" Grid.Column="1">
                                            <TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock x:Name="TileGpu" Text="--" FontSize="24" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel x:Name="MetricVram" Grid.Column="2">
                                            <TextBlock Text="VRAM" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock x:Name="TileVram" Text="--" FontSize="24" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel x:Name="MetricTemp" Grid.Column="3">
                                            <TextBlock Text="GPU TEMP" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock x:Name="TileTemp" Text="--" FontSize="24" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel x:Name="MetricApp" Grid.Column="4">
                                            <TextBlock Text="VR APP" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock
                                                x:Name="TileApp"
                                                Text="none detected"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- GESTURE -->
                        <StackPanel x:Name="PageGesture" Spacing="18" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="18">
                                    <ComboBox
                                        x:Name="HandCombo"
                                        Header="Which controller"
                                        AutomationProperties.Name="Which controller"
                                        MaxWidth="360"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="Either controller" />
                                        <ComboBoxItem Content="Left only" />
                                        <ComboBoxItem Content="Right only" />
                                    </ComboBox>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="FlipAngleLabel" Text="Flip angle" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock
                                            Style="{StaticResource MutedTextStyle}"
                                            FontSize="12"
                                            Text="How far the controller rotates from upright. Lower triggers more easily; higher avoids accidental activation during play." />
                                        <Slider
                                            x:Name="FlipAngleSlider"
                                            Minimum="60"
                                            Maximum="175"
                                            MaxWidth="560"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Flip angle in degrees"
                                            AutomationProperties.HelpText="Lower values trigger more easily; higher values reduce accidental activation."
                                            ValueChanged="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="ShowDelayLabel" Text="Show delay" Style="{StaticResource SettingLabelStyle}" />
                                        <Slider
                                            x:Name="ShowDelaySlider"
                                            Minimum="0"
                                            Maximum="150"
                                            MaxWidth="560"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Show delay in seconds"
                                            ValueChanged="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="HideDelayLabel" Text="Hide delay" Style="{StaticResource SettingLabelStyle}" />
                                        <Slider
                                            x:Name="HideDelaySlider"
                                            Minimum="0"
                                            Maximum="300"
                                            MaxWidth="560"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Hide delay in seconds"
                                            ValueChanged="Setting_Changed" />
                                    </StackPanel>

                                    <CheckBox
                                        x:Name="F10Check"
                                        Content="F10 toggles a head-locked HUD"
                                        Click="Setting_Changed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel x:Name="PageAppearance" Spacing="18" Visibility="Collapsed">
                            <Grid x:Name="AppearanceGrid" ColumnSpacing="18" RowSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="AppearanceSettingsCard" Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="PanelWidthLabel" Text="Panel width" Style="{StaticResource SettingLabelStyle}" />
                                            <Slider
                                                x:Name="PanelWidthSlider"
                                                Minimum="10"
                                                Maximum="80"
                                                MaxWidth="560"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Panel width in centimeters"
                                                ValueChanged="Setting_Changed" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="PanelOffsetLabel" Text="Distance from controller" Style="{StaticResource SettingLabelStyle}" />
                                            <Slider
                                                x:Name="PanelOffsetSlider"
                                                Minimum="0"
                                                Maximum="40"
                                                MaxWidth="560"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Distance from controller in centimeters"
                                                ValueChanged="Setting_Changed" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="PanelRollLabel" Text="Roll" Style="{StaticResource SettingLabelStyle}" />
                                            <Slider
                                                x:Name="PanelRollSlider"
                                                Minimum="-90"
                                                Maximum="90"
                                                MaxWidth="560"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Panel roll in degrees"
                                                ValueChanged="Setting_Changed" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="OpacityLabel" Text="Opacity" Style="{StaticResource SettingLabelStyle}" />
                                            <Slider
                                                x:Name="OpacitySlider"
                                                Minimum="15"
                                                Maximum="100"
                                                MaxWidth="560"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="HUD opacity percent"
                                                ValueChanged="Setting_Changed" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="ThemeCombo"
                                            Header="HUD theme"
                                            AutomationProperties.Name="HUD theme"
                                            MaxWidth="360"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="Setting_Changed">
                                            <ComboBoxItem Content="Midnight" />
                                            <ComboBoxItem Content="Porcelain" />
                                            <ComboBoxItem Content="High contrast" />
                                            <ComboBoxItem Content="Aurora" />
                                            <ComboBoxItem Content="Ember" />
                                            <ComboBoxItem Content="Glacier" />
                                        </ComboBox>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="RefreshLabel" Text="HUD refresh" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextStyle}"
                                                FontSize="12"
                                                Text="How often the panel repaints. The graph samples every frame; lower values reduce render-thread work." />
                                            <Slider
                                                x:Name="RefreshSlider"
                                                Minimum="10"
                                                Maximum="200"
                                                MaxWidth="560"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="HUD refresh rate in hertz"
                                                ValueChanged="Setting_Changed" />
                                        </StackPanel>
                                        <Border Height="1" Background="{ThemeResource CardStrokeBrush}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Reset HUD settings" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock
                                                Text="Restores gesture, placement, appearance, and readout defaults."
                                                Style="{StaticResource MutedTextStyle}"
                                                FontSize="12" />
                                            <Button
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Restore defaults…"
                                                HorizontalAlignment="Left"
                                                Click="RestoreDefaults_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="AppearancePreviewCard"
                                    Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                        <ComboBox
                                            x:Name="PreviewRateCombo2"
                                            Header="Headset refresh rate"
                                            AutomationProperties.Name="Preview headset refresh rate"
                                            SelectionChanged="PreviewRate_Changed">
                                            <ComboBoxItem Content="72 Hz" />
                                            <ComboBoxItem Content="80 Hz" />
                                            <ComboBoxItem Content="90 Hz" />
                                            <ComboBoxItem Content="120 Hz" />
                                            <ComboBoxItem Content="144 Hz" />
                                        </ComboBox>
                                        <Border CornerRadius="10" Padding="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF253044" Offset="0" />
                                                    <GradientStop Color="#FF11151C" Offset="0.5" />
                                                    <GradientStop Color="#FF344054" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Image x:Name="PreviewImage2" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- READOUTS -->
                        <StackPanel x:Name="PageReadouts" Spacing="18" Visibility="Collapsed">
                            <Grid x:Name="ReadoutsGrid" ColumnSpacing="18" RowSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ReadoutSettingsColumn" Grid.Column="0" Spacing="18">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Frame statistics" Style="{StaticResource CardTitleStyle}" />
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    x:Name="TimingSourceCombo"
                                                    Grid.Column="0"
                                                    Header="Timing source"
                                                    AutomationProperties.Name="Frame timing source"
                                                    SelectionChanged="Setting_Changed">
                                                    <ComboBoxItem Content="Auto — best available" />
                                                    <ComboBoxItem Content="SteamVR compositor" />
                                                    <ComboBoxItem Content="Meta performance metrics" />
                                                    <ComboBoxItem Content="OpenXR submissions" />
                                                </ComboBox>
                                                <ComboBox
                                                    x:Name="GraphModeCombo"
                                                    Grid.Column="1"
                                                    Header="Graph"
                                                    AutomationProperties.Name="Frametime graph mode"
                                                    SelectionChanged="Setting_Changed">
                                                    <ComboBoxItem Content="Auto — best available" />
                                                    <ComboBoxItem Content="Application frametime" />
                                                    <ComboBoxItem Content="CPU + GPU — combined" />
                                                    <ComboBoxItem Content="CPU and GPU — separate graphs" />
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock
                                                x:Name="TimingSourceStatus"
                                                Text="Auto will choose the best timing source exposed by the active runtime."
                                                Style="{StaticResource MutedTextStyle}"
                                                FontSize="12"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="10">
                                                    <CheckBox x:Name="ShowFps" Content="FPS" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowTarget" Content="Target frametime" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowPercentiles" Content="1% low" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowCpuFrametime" Content="CPU frametime" Click="Setting_Changed" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="10">
                                                    <CheckBox x:Name="ShowFrametime" Content="Frametime" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowGpuFrametime" Content="GPU frametime" Click="Setting_Changed" />
                                                    <CheckBox
                                                        x:Name="ShowOnTarget"
                                                        Content="On-target %"
                                                        ToolTipService.ToolTip="Share of recent frames delivered within 6% of the target period."
                                                        Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowGraph" Content="Frametime graph" Click="Setting_Changed" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="System metrics" Style="{StaticResource CardTitleStyle}" />
                                            <InfoBar
                                                IsOpen="True"
                                                IsClosable="False"
                                                Severity="Informational"
                                                Message="Leave the Control Center open or minimized to keep these rows live." />
                                            <TextBlock
                                                x:Name="MetricCapabilitySummary"
                                                Style="{StaticResource MutedTextStyle}"
                                                FontSize="12" />
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="10">
                                                    <CheckBox x:Name="ShowCpuUsage" Content="CPU usage" Click="Setting_Changed" />
                                                    <CheckBox
                                                        x:Name="ShowGpuAppUsage"
                                                        Content="GPU usage (this game)"
                                                        ToolTipService.ToolTip="Appears when an OpenXR app has loaded the xrFPS layer."
                                                        Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowGpuClock" Content="GPU clock" Click="Setting_Changed" />
                                                    <CheckBox
                                                        x:Name="ShowCpuTemp"
                                                        Content="CPU temperature"
                                                        ToolTipService.ToolTip="No CPU temperature provider is currently available."
                                                        Click="Setting_Changed" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="10">
                                                    <CheckBox x:Name="ShowGpuUsage" Content="GPU usage (total)" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowVram" Content="VRAM" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowGpuTemp" Content="GPU temperature" Click="Setting_Changed" />
                                                    <CheckBox x:Name="ShowRam" Content="System RAM" Click="Setting_Changed" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border
                                    x:Name="ReadoutsPreviewCard"
                                    Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                        <ComboBox
                                            x:Name="PreviewRateCombo3"
                                            Header="Headset refresh rate"
                                            AutomationProperties.Name="Preview headset refresh rate"
                                            SelectionChanged="PreviewRate_Changed">
                                            <ComboBoxItem Content="72 Hz" />
                                            <ComboBoxItem Content="80 Hz" />
                                            <ComboBoxItem Content="90 Hz" />
                                            <ComboBoxItem Content="120 Hz" />
                                            <ComboBoxItem Content="144 Hz" />
                                        </ComboBox>
                                        <Border CornerRadius="10" Padding="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF253044" Offset="0" />
                                                    <GradientStop Color="#FF11151C" Offset="0.5" />
                                                    <GradientStop Color="#FF344054" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Image x:Name="PreviewImage3" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                        </Border>
                                        <TextBlock
                                            Text="System rows arrange in two columns so the frametime graph keeps a readable minimum height."
                                            Style="{StaticResource MutedTextStyle}"
                                            FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- INSTALLATION -->
                        <StackPanel x:Name="PageInstall" Spacing="18" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse
                                            x:Name="InstallPageStatusDot"
                                            Width="10"
                                            Height="10"
                                            Fill="{ThemeResource MutedTextBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="InstallPageStatusHeadline"
                                            Text="Checking installation"
                                            Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="InstallPageStatusDetail"
                                        Style="{StaticResource MutedTextStyle}"
                                        FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="InstallButton2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Install layer"
                                            Click="Install_Click" />
                                        <Button
                                            x:Name="UninstallButton2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Uninstall…"
                                            Click="Uninstall_Click" />
                                        <Button
                                            x:Name="ReinstallButton2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Update files"
                                            Click="Install_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="How it works" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock
                                        Style="{StaticResource MutedTextStyle}"
                                        FontSize="13"
                                        Text="xrFPS installs as a per-user implicit OpenXR API layer. Every OpenXR app started afterwards loads it automatically—no injection, per-game setup, or administrator rights. Each build uses its own filename so files can update while a game still holds the previous build open." />
                                    <Border Height="1" Background="{ThemeResource CardStrokeBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="LAYER MANIFEST" Style="{StaticResource EyebrowStyle}" />
                                        <TextBox
                                            x:Name="ManifestPathText"
                                            IsReadOnly="True"
                                            AutomationProperties.Name="Layer manifest path" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="SETTINGS FILE" Style="{StaticResource EyebrowStyle}" />
                                        <TextBox
                                            x:Name="ConfigPathText"
                                            IsReadOnly="True"
                                            AutomationProperties.Name="Settings file path" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Open folder"
                                            Click="OpenFolder_Click" />
                                        <Button
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Open log"
                                            Click="OpenLog_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Updates" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock
                                        x:Name="VersionText"
                                        Style="{StaticResource MutedTextStyle}"
                                        FontSize="13" />
                                    <TextBlock
                                        Style="{StaticResource MutedTextStyle}"
                                        FontSize="12"
                                        Text="xrFPS checks GitHub for a newer release when it starts. Updating installs the new layer alongside the running one, so a game in progress keeps working." />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="CheckUpdateButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Check for updates"
                                            Click="CheckUpdate_Click" />
                                        <ProgressRing
                                            x:Name="UpdateRing"
                                            IsActive="False"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="UpdateStatusText"
                                            Style="{StaticResource MutedTextStyle}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
