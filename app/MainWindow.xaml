<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlipFPS.ControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#FF0A0C11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Padding="18,16,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,28,0,26">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource BrandBrush}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#FF071113" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FlipFPS" FontSize="19" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="CONTROL CENTER" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="140" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="OVERLAY" Style="{StaticResource EyebrowStyle}" Margin="4,0,0,10" />
                    <Button x:Name="NavDashboard" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavGesture" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="1">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7C9;" FontSize="16" />
                            <TextBlock Text="Gesture" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAppearance" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE790;" FontSize="16" />
                            <TextBlock Text="Placement &amp; look" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReadouts" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="3">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                            <TextBlock Text="Readouts" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavInstall" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                            <TextBlock Text="Installation" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LAYER" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SidebarStatusText" Text="checking..." FontSize="13"
                                   FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="SidebarHintText" Text="" Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" Padding="34,28,34,28" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PageEyebrow" Text="OVERLAY" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource MutedTextStyle}"
                               Text="Flip a controller upside down to see your frame rate in any OpenXR game." />
                </StackPanel>

                <!-- DASHBOARD -->
                <StackPanel x:Name="PageDashboard" Spacing="18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                             Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusHeadline" Text="Checking installation"
                                               Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="StatusDetail" Style="{StaticResource MutedTextStyle}" FontSize="13" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Install layer" Click="Install_Click" />
                                    <Button x:Name="UninstallButton" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Uninstall" Click="Uninstall_Click" />
                                    <Button x:Name="ReinstallButton" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Update files" Click="Install_Click" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource CardStrokeBrush}" />

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Overlay enabled" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Applies instantly, even to a game already running."
                                                   Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnabledToggle" HorizontalAlignment="Right"
                                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="330">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                <Border CornerRadius="10" Background="#FF12141A" Padding="10">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                </Border>
                                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11"
                                           Text="Drawn by the layer's own renderer, so this is exactly what appears in the headset." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Live system metrics" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="CollectorStatus" Style="{StaticResource MutedTextStyle}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnSpacing="14" x:Name="MetricTiles">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TileCpu" Text="--" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TileGpu" Text="--" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VRAM" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TileVram" Text="--" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="GPU TEMP" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TileTemp" Text="--" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="VR APP" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TileApp" Text="none" FontSize="15" FontWeight="SemiBold"
                                               Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- GESTURE -->
                <StackPanel x:Name="PageGesture" Spacing="18" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Which controller" Style="{StaticResource SettingLabelStyle}" />
                                <ComboBox x:Name="HandCombo" Width="280" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Either controller" />
                                    <ComboBoxItem Content="Left only" />
                                    <ComboBoxItem Content="Right only" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="FlipAngleLabel" Text="Flip angle" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12"
                                           Text="How far past upright the controller must rotate. Lower triggers more easily; higher avoids showing the HUD during play." />
                                <Slider x:Name="FlipAngleSlider" Minimum="60" Maximum="175" Width="440"
                                        ValueChanged="Setting_Changed" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ShowDelayLabel" Text="Show delay" Style="{StaticResource SettingLabelStyle}" />
                                <Slider x:Name="ShowDelaySlider" Minimum="0" Maximum="150" Width="440"
                                        ValueChanged="Setting_Changed" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HideDelayLabel" Text="Hide delay" Style="{StaticResource SettingLabelStyle}" />
                                <Slider x:Name="HideDelaySlider" Minimum="0" Maximum="300" Width="440"
                                        ValueChanged="Setting_Changed" />
                            </StackPanel>

                            <CheckBox x:Name="F10Check" Content="F10 toggles a head-locked HUD"
                                      Click="Setting_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- APPEARANCE -->
                <StackPanel x:Name="PageAppearance" Spacing="18" Visibility="Collapsed">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PanelWidthLabel" Text="Panel width" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider x:Name="PanelWidthSlider" Minimum="10" Maximum="80" Width="420" ValueChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PanelOffsetLabel" Text="Distance from controller" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider x:Name="PanelOffsetSlider" Minimum="0" Maximum="40" Width="420" ValueChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PanelRollLabel" Text="Roll" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider x:Name="PanelRollSlider" Minimum="-90" Maximum="90" Width="420" ValueChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="OpacityLabel" Text="Opacity" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider x:Name="OpacitySlider" Minimum="15" Maximum="100" Width="420" ValueChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Theme" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox x:Name="ThemeCombo" Width="280" SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="High contrast" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="RefreshLabel" Text="HUD refresh" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12"
                                               Text="How often the panel repaints. The graph samples every frame regardless; lower values leave the game's render thread alone." />
                                    <Slider x:Name="RefreshSlider" Minimum="10" Maximum="200" Width="420" ValueChanged="Setting_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="330" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                <Border CornerRadius="10" Background="#FF12141A" Padding="10">
                                    <Image x:Name="PreviewImage2" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- READOUTS -->
                <StackPanel x:Name="PageReadouts" Spacing="18" Visibility="Collapsed">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="18">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Frame statistics" Style="{StaticResource CardTitleStyle}" />
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="10">
                                            <CheckBox x:Name="ShowFps" Content="FPS" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowTarget" Content="Target frametime" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowPercentiles" Content="1% low" Click="Setting_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <CheckBox x:Name="ShowFrametime" Content="Frametime" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowOnTarget" Content="On-target %" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowGraph" Content="Frametime graph" Click="Setting_Changed" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="System metrics" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12"
                                               Text="Sampled by this app and handed to the layer — a layer inside a game cannot read them itself, so leave the Control Center running to keep these live." />
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="10">
                                            <CheckBox x:Name="ShowCpuUsage" Content="CPU usage" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowGpuAppUsage" Content="GPU usage (this game)" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowGpuClock" Content="GPU clock" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowCpuTemp" Content="CPU temperature" Click="Setting_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <CheckBox x:Name="ShowGpuUsage" Content="GPU usage (total)" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowVram" Content="VRAM" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowGpuTemp" Content="GPU temperature" Click="Setting_Changed" />
                                            <CheckBox x:Name="ShowRam" Content="System RAM" Click="Setting_Changed" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="330" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PREVIEW" Style="{StaticResource EyebrowStyle}" />
                                <Border CornerRadius="10" Background="#FF12141A" Padding="10">
                                    <Image x:Name="PreviewImage3" Stretch="Uniform" HorizontalAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- INSTALLATION -->
                <StackPanel x:Name="PageInstall" Spacing="18" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="How it works" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="13"
                                       Text="FlipFPS installs as a per-user implicit OpenXR API layer. Every OpenXR app started afterwards loads it automatically — no injection, no per-game setup, and no administrator rights. Each build is installed under its own filename so it can be updated while a game still holds the old one open." />
                            <Border Height="1" Background="{StaticResource CardStrokeBrush}" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Layer manifest" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="ManifestPathText" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings file" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="ConfigPathText" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open folder" Click="OpenFolder_Click" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open log" Click="OpenLog_Click" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Restore defaults" Click="RestoreDefaults_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ToastText" Style="{StaticResource MutedTextStyle}" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
