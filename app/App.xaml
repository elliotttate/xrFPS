<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="xrFPS.ControlCenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- x:Key="Default", not "Dark": theme lookup falls back to
                     "Default" but never across to a sibling theme, so on a
                     light-mode machine a "Dark"-only table makes every
                     ThemeResource lookup fail — a startup XamlParseException
                     for most of the world, since Windows ships light. -->
                <ResourceDictionary x:Key="Default">
                    <!-- Keep native controls in the same green family as the app. -->
                    <Color x:Key="SystemAccentColor">#FF56CF85</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF6DDB97</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF83E5A8</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFA9F0C2</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF43B571</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF32975C</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF237642</Color>

                    <SolidColorBrush x:Key="BrandBrush" Color="#FF56CF85" />
                    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#FF6EA8FE" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FF12151C" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#FF252B36" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA6AFBE" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#FF5EE6A8" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#FFFFC857" />
                    <SolidColorBrush x:Key="BadBrush" Color="#FFFF6B7A" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#FF0C0E14" />
                    <SolidColorBrush x:Key="RootBackgroundBrush" Color="#FF0A0C11" />
                    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#FF1A202B" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF0C0E14" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF0C0E14" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF0A0C11" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF173128" />
                </ResourceDictionary>

                <!-- Windows high-contrast mode remains authoritative. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="GoodBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WarnBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="BadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RootBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource BrandBrush}" />
                <Setter Property="Foreground" Value="#FF071113" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="18,10" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="16,9" />
            </Style>

            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
