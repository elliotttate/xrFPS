<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Since .NET 8 a RuntimeIdentifier no longer implies a self-contained
         publish, and Windows does not ship a .NET 9 runtime; without this the
         release only starts on machines that installed one by hand. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>xrFPS.ControlCenter</RootNamespace>
    <AssemblyName>xrFPS.ControlCenter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\xrFPS.ico</ApplicationIcon>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\xrFPS.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The native core carries the real config, HUD renderer, installer and
       metrics collector; the app is its front end. -->
  <ItemGroup>
    <None Include="..\build\Release\xrfps_core.dll" Condition="Exists('..\build\Release\xrfps_core.dll')">
      <Link>xrfps_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\build\Release\XrApiLayer_xrfps.dll" Condition="Exists('..\build\Release\XrApiLayer_xrfps.dll')">
      <Link>XrApiLayer_xrfps.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\build\Release\xrfps_frametime.exe" Condition="Exists('..\build\Release\xrfps_frametime.exe')">
      <Link>xrfps_frametime.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\manifest\XrApiLayer_xrfps.json">
      <Link>XrApiLayer_xrfps.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUIResourcePayload Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
      <_WinUIResourcePayload Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIResourcePayload)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
